# Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file containing secrets.
#
# NOTE: This file only lists variables that are actually referenced or planned.
# Do NOT place real credentials here — this is an EXAMPLE file only.

# ─── Node / Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Server (Express HTTP API) ───────────────────────────────────────────────
SERVER_PORT=3001
# WEBSOCKET_PORT=3002          # Separate WS port (future; same-port currently used)
# CLIENT_URL=http://localhost:5173  # CORS allowed origin list (future)

# ─── Client (Vite exposes vars prefixed with VITE_ to the browser) ───────────
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# ─── Database (PostgreSQL — NOT used in Prompt 2) ────────────────────────────
# DATABASE_URL=postgresql://postgres:change_me@localhost:5432/mini_internet
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mini_internet
# DB_USER=postgres
# DB_PASSWORD=change_me

# ─── Simulation (NOT used in Prompt 2 — documented for future phases) ────────
# SIMULATION_TICK_MS=100         # Discrete event loop tick interval (ms)
# SIMULATION_DEFAULT_SEED=42     # Default PRNG seed for deterministic experiments
